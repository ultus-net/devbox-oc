{
  "format_version": "1.2",
  "resource_changes": [
    {
      "address": "azurerm_network_interface.vm",
      "type": "azurerm_network_interface",
      "name": "vm",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "nic-devbox-oc",
          "public_ip_address_id": null
        }
      }
    },
    {
      "address": "azurerm_network_security_group.vm",
      "type": "azurerm_network_security_group",
      "name": "vm",
      "change": {
        "actions": ["create"],
        "after": {
          "security_rule": [
            {
              "name": "deny-inbound-internet",
              "direction": "Inbound",
              "access": "Deny",
              "protocol": "*",
              "source_address_prefix": "Internet"
            },
            {
              "name": "allow-inbound-vnet-ssh",
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "destination_port_range": "22",
              "source_address_prefix": "VirtualNetwork"
            }
          ]
        }
      }
    }
  ]
}
