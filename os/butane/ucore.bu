# os/butane/ucore.bu
#
# Placeholders are filled in by build.sh, which then runs Butane with
# --files-dir at the repo root, so every local: path is relative to the root.
variant: fcos
version: 1.5.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - __SSH_PUBKEY__
storage:
  disks:
    - device: /dev/disk/azure/scsi1/lun0
      wipe_table: false
      partitions:
        - label: data
          number: 1
  # The autorebase units gate on marker files in this directory. Ignition creates
  # it, and /etc survives a rebase, so the markers outlive the OS switch they record.
  directories:
    - path: /etc/ucore-autorebase
      mode: 0755
  filesystems:
    - device: /dev/disk/by-partlabel/data
      format: ext4
      label: data
      wipe_filesystem: false
  files:
    - path: /usr/local/sbin/oc-secrets
      mode: 0755
      contents:
        local: host/bin/oc-secrets
    - path: /usr/local/sbin/oc-acr-login
      mode: 0755
      contents:
        local: host/bin/oc-acr-login
    - path: /usr/local/sbin/oc-idle-check
      mode: 0755
      contents:
        local: host/bin/oc-idle-check
    - path: /usr/local/sbin/oc-snapshot
      mode: 0755
      contents:
        local: host/bin/oc-snapshot
    - path: /usr/local/sbin/oc-tailnet
      mode: 0755
      contents:
        local: host/bin/oc-tailnet
    - path: /usr/local/sbin/oc-tailnet-up
      mode: 0755
      contents:
        local: host/bin/oc-tailnet-up
    - path: /usr/local/sbin/lib-imds.sh
      mode: 0644
      contents:
        local: host/bin/lib-imds.sh
    - path: /usr/local/sbin/oc-paths
      mode: 0755
      contents:
        inline: |
          #!/bin/sh
          set -eu
          install -d -o 1000 -g 1000 \
            /srv/repos /srv/opencode/share /srv/opencode/config /srv/opencode/state
    # Rendered from host/quadlet/opencode.container by build.sh, so the ACR name
    # is substituted before the quadlet is baked in.
    - path: /etc/containers/systemd/opencode.container
      mode: 0644
      contents:
        local: os/butane/.opencode.container.ign.tmp
    - path: /etc/devbox/oc-secrets.env
      mode: 0600
      contents:
        inline: |
          VAULT_NAME=__VAULT_NAME__
          ACR_NAME=__ACR_NAME__
          # The one shipped definition of where the password goes. The quadlet loads
          # this same path, so the producer and the consumer name it in one place
          # instead of agreeing by coincidence of a script default. A guard test
          # requires exactly one definition across every shipped file and unit.
          OUT_FILE=/etc/opencode/env
          # Without this the tailnet join has no key source on a fresh box, and
          # oc-tailnet-up fails with "no auth key".
          TS_AUTHKEY_SECRET=__TS_AUTHKEY_SECRET__
    - path: /etc/devbox/oc-idle.env
      mode: 0600
      contents:
        inline: |
          IDLE_MIN=45
          BOOT_GRACE=900
    - path: /etc/devbox/oc-snapshot.env
      mode: 0600
      contents:
        inline: |
          DISK_ID=__DISK_ID__
          RG=__RG__
          SUBSCRIPTION_ID=__SUBSCRIPTION_ID__
systemd:
  units:
    # A mount unit's name must match its Where= path, so /srv is srv.mount.
    - name: srv.mount
      enabled: true
      contents: |
        [Unit]
        Description=Devbox data disk
        [Mount]
        What=/dev/disk/by-label/data
        Where=/srv
        Type=ext4
        Options=defaults,noatime,nofail
        [Install]
        WantedBy=local-fs.target
    - name: oc-secrets.service
      enabled: true
      contents: |
        [Unit]
        Description=Write OpenCode env and ACR auth from Key Vault
        After=network-online.target srv.mount
        Wants=network-online.target
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        EnvironmentFile=/etc/devbox/oc-secrets.env
        ExecStart=/usr/local/sbin/oc-secrets
        ExecStart=/usr/local/sbin/oc-acr-login
        [Install]
        WantedBy=multi-user.target
    - name: oc-paths.service
      enabled: true
      contents: |
        [Unit]
        Description=Create persistent directory layout on the data disk
        After=srv.mount
        Requires=srv.mount
        Before=opencode.service
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/sbin/oc-paths
        [Install]
        WantedBy=multi-user.target
    - name: oc-idle.service
      contents: |
        [Unit]
        Description=Probe for idleness
        After=opencode.service
        [Service]
        Type=oneshot
        # oc-secrets.env carries OUT_FILE, which is where the password file is. The
        # idle env file only carries the tuning knobs, so a path change touches one
        # file and both the writer and this probe follow it.
        EnvironmentFile=/etc/devbox/oc-secrets.env
        EnvironmentFile=/etc/devbox/oc-idle.env
        ExecStart=/usr/local/sbin/oc-idle-check
    - name: oc-idle.timer
      enabled: true
      contents: |
        [Unit]
        Description=Check idleness every 5 minutes
        [Timer]
        OnBootSec=20min
        OnUnitActiveSec=5min
        [Install]
        WantedBy=timers.target
    - name: oc-snapshot.service
      contents: |
        [Unit]
        Description=Snapshot the data disk
        After=srv.mount
        [Service]
        Type=oneshot
        EnvironmentFile=/etc/devbox/oc-snapshot.env
        ExecStart=/usr/local/sbin/oc-snapshot
    - name: oc-snapshot.timer
      enabled: true
      contents: |
        [Unit]
        Description=Nightly data disk snapshot
        [Timer]
        OnCalendar=*-*-* 02:00:00 UTC
        Persistent=true
        [Install]
        WantedBy=timers.target
    # ucore installs the tailscale RPM but enables no service, and it vendors the
    # repo disabled. Without this the join below has no daemon to talk to, and the
    # box has no reachable path on first boot.
    #
    # No contents: this enables the shipped unit. A contents block would shadow
    # /lib/systemd/system/tailscaled.service.
    - name: tailscaled.service
      enabled: true
    - name: oc-tailnet.service
      enabled: true
      contents: |
        [Unit]
        Description=Join the tailnet and serve OpenCode over TLS
        After=network-online.target oc-secrets.service tailscaled.service
        Wants=network-online.target tailscaled.service
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        # A unit does not inherit another unit's EnvironmentFile. Without this the
        # join runs with TS_AUTHKEY_SECRET and VAULT_NAME unset, skips Key Vault
        # entirely, and fails with "no auth key" on every fresh boot.
        EnvironmentFile=/etc/devbox/oc-secrets.env
        # Joins only when no state exists, then advertises the loopback port.
        ExecStart=/usr/local/sbin/oc-tailnet-up
        ExecStart=/usr/local/sbin/oc-tailnet
        [Install]
        WantedBy=multi-user.target
    # ucore ships podman-restart.service already; do not redefine it. Enable the
    # shipped one instead, plus the auto-update timer that AutoUpdate=registry
    # depends on.
    - name: podman-restart.service
      enabled: true
      dropins:
        - name: 10-devbox.conf
          contents: |
            [Unit]
            After=oc-secrets.service
    - name: podman-auto-update.timer
      enabled: true
    # The published Azure image is Fedora CoreOS, not ucore. Fedora publishes no
    # ucore Azure VHD and the design forbids forking ucore, so the box installs as
    # FCOS and rebases onto the ucore container image on first boot. This is the
    # upstream auto-rebase template, with the target pinned by tag as ucore
    # documents; ucore's rpm-ostreed timer then keeps it current.
    #
    # Two stages, not one. The first rebase binds an unverified reference, so it
    # reboots. Only after booting ucore does the installed container-signing policy
    # exist, which is what the second stage needs to accept a signed reference.
    # Each stage touches a marker so a reboot cannot loop it.
    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=Rebase from FCOS to the ucore image, then reboot
        ConditionPathExists=!/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        # The rebase pulls a 1.5 GB image, so it needs working DNS and a route to
        # the registry. network-online.target is the only ordering it needs: on this
        # first boot the box is still plain FCOS, so ordering after any oc-* unit
        # would just wait on a unit that cannot work before the rebase it gates.
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/ublue-os/ucore-minimal:stable
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
    - name: ucore-signed-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=Switch to the signed ucore reference, then reboot
        ConditionPathExists=/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase ostree-image-signed:docker://ghcr.io/ublue-os/ucore-minimal:stable
        # Enablement above is preset-only, and the preset ran on the FCOS boot
        # where this unit did not exist yet. Enabling here creates the real
        # symlink, so is-enabled tells the truth on the booted host. This runs
        # before the marker is written: a failure then retries on the next boot
        # instead of marking a half-done stage as complete.
        ExecStart=/usr/bin/systemctl enable tailscaled.service
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/signed
        ExecStart=/usr/bin/systemctl disable ucore-signed-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
