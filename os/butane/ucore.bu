# os/butane/ucore.bu
#
# Ignition for a bare-metal install. Fedora CoreOS installation media writes
# this config to the OS disk, then a one-shot unit rebases the machine to
# ucore-minimal and reboots. Everything here lives in /etc or /usr/local, both of
# which survive the rebase.
#
# Placeholders are filled in by build.sh, which then runs Butane with
# --files-dir at the repo root, so every local: path is relative to the root.
variant: fcos
version: 1.5.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - __SSH_PUBKEY__
storage:
  directories:
    - path: /etc/ucore-autorebase
      mode: 0755
  # ucore ships the tailscale RPM but enables no service. The first boot is
  # Fedora CoreOS, where `enabled: true` on a unit that does not exist yet does
  # not stick, so write the wants symlink directly. It is dangling until the
  # rebase installs tailscaled, then it takes effect.
  links:
    - path: /etc/systemd/system/multi-user.target.wants/tailscaled.service
      target: /usr/lib/systemd/system/tailscaled.service
      hard: false
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: __OC_HOSTNAME__
    # The one secret that may ride the install media. Scoped to a tag,
    # single-use or short-lived, and revoked after the node joins. A keyless build
    # leaves this file empty, and the operator joins from the console. The
    # OpenCode password never rides here: it is written after first boot.
    - path: /etc/devbox/tailscale-authkey
      mode: 0600
      contents:
        inline: __TS_AUTHKEY__
    # A keyless build has no tailnet, and sshd is masked, so the local console is
    # the only way in until the join. FCOS ignores coreos.autologin, so write the
    # getty drop-in instead. Use the upstream getty arguments and add autologin;
    # the unit's TTYPath selects the console. `core` already has passwordless sudo.
    - path: /etc/systemd/system/getty@tty1.service.d/10-autologin.conf
      mode: 0644
      contents:
        inline: |
          [Service]
          ExecStart=
          ExecStart=-/usr/sbin/agetty --autologin core --noreset --noclear - ${TERM}
    - path: /usr/local/sbin/oc-env
      mode: 0755
      contents:
        local: host/bin/oc-env
    - path: /usr/local/sbin/oc-backup
      mode: 0755
      contents:
        local: host/bin/oc-backup
    - path: /usr/local/sbin/oc-restic
      mode: 0755
      contents:
        local: host/bin/oc-restic
    - path: /usr/local/sbin/oc-tailnet
      mode: 0755
      contents:
        local: host/bin/oc-tailnet
    - path: /usr/local/sbin/oc-tailnet-up
      mode: 0755
      contents:
        local: host/bin/oc-tailnet-up
    - path: /usr/local/sbin/oc-paths
      mode: 0755
      contents:
        inline: |
          #!/bin/sh
          set -eu
          install -d -o 1000 -g 1000 \
            /srv/repos /srv/opencode/share /srv/opencode/config /srv/opencode/state
    # The image reference is rendered here as well, so the backup runs the same
    # Fedora image as the workload and no Alpine restic image is needed.
    - path: /etc/devbox/backup.env
      mode: 0644
      contents:
        inline: |
          RESTIC_IMAGE=__IMAGE__
    # Rendered from host/quadlet/opencode.container by build.sh, so the image
    # reference is substituted before the quadlet is baked into the install media.
    - path: /etc/containers/systemd/opencode.container
      mode: 0644
      contents:
        local: os/butane/.opencode.container.ign.tmp
    # An idle policy must not take the box off the tailnet.
    - path: /etc/systemd/logind.conf.d/10-devbox.conf
      mode: 0644
      contents:
        inline: |
          [Login]
          IdleAction=ignore
systemd:
  units:
    # First boot is Fedora CoreOS. This rebases it to ucore-minimal and reboots.
    # The marker file stops a second run on the ucore boot, and disabling the
    # unit is a belt-and-braces second copy of the same condition.
    - name: ucore-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=Rebase Fedora CoreOS to ucore-minimal and reboot
        ConditionPathExists=!/etc/ucore-autorebase/done
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:__UCORE_IMAGE__
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/done
        ExecStart=/usr/bin/systemctl disable ucore-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
    # A mount unit's name must match its Where= path, so /srv is srv.mount.
    # The partition and filesystem are prepared once, outside Ignition, so an OS
    # reinstall cannot wipe the data disk. Ignition only mounts it by label.
    - name: srv.mount
      enabled: true
      contents: |
        [Unit]
        Description=Devbox data disk
        [Mount]
        What=/dev/disk/by-label/data
        Where=/srv
        Type=ext4
        Options=defaults,noatime,nofail
        TimeoutSec=30
        [Install]
        WantedBy=local-fs.target
    - name: oc-paths.service
      enabled: true
      contents: |
        [Unit]
        Description=Create the persistent directory layout on the data disk
        After=srv.mount
        Requires=srv.mount
        Before=opencode.service
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/sbin/oc-paths
        [Install]
        WantedBy=multi-user.target
    - name: oc-env.service
      enabled: true
      contents: |
        [Unit]
        Description=Write the OpenCode environment file from secrets.env
        After=srv.mount
        Requires=srv.mount
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/sbin/oc-env
        [Install]
        WantedBy=multi-user.target
    - name: oc-backup.service
      contents: |
        [Unit]
        Description=Back up the data disk with restic
        After=srv.mount network-online.target
        Wants=network-online.target
        Requires=srv.mount
        [Service]
        Type=oneshot
        Nice=10
        IOSchedulingClass=idle
        # Stop the workload so the session database is not captured mid-write.
        # The leading - keeps the backup running if the stop already happened.
        ExecStartPre=-/usr/bin/systemctl stop opencode.service
        ExecStart=/usr/local/sbin/oc-backup
        # Run after success or failure, so a failed backup never leaves the server
        # down.
        ExecStopPost=-/usr/bin/systemctl start opencode.service
    - name: oc-backup.timer
      enabled: true
      contents: |
        [Unit]
        Description=Nightly restic backup of the data disk
        [Timer]
        OnCalendar=*-*-* 02:00:00
        Persistent=true
        RandomizedDelaySec=30min
        [Install]
        WantedBy=timers.target
    - name: oc-tailnet.service
      enabled: true
      contents: |
        [Unit]
        Description=Join the tailnet and serve OpenCode over TLS
        # The first boot is Fedora CoreOS, which has no tailscale binary. Skip
        # there instead of failing loudly, then run on the ucore boot.
        ConditionPathExists=/usr/bin/tailscale
        After=network-online.target tailscaled.service
        Wants=network-online.target tailscaled.service
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/sbin/oc-tailnet-up
        ExecStart=/usr/local/sbin/oc-tailnet
        [Install]
        WantedBy=multi-user.target
    # ucore-minimal ships Cockpit and switches firewalld to the server profile so
    # it is reachable. The shipped cockpit.socket listens on 9090 across every
    # interface, and the service behind it runs privileged with / mounted. This
    # design has one door, the tailnet, so the socket is rebound to loopback.
    #
    # An empty assignment resets a list option, so `ListenStream=` first drops the
    # shipped 9090 and the loopback line replaces it. Without the reset the second
    # ListenStream would append and leave 9090 open.
    - name: cockpit.socket
      dropins:
        - name: 10-loopback.conf
          contents: |
            [Socket]
            ListenStream=
            ListenStream=127.0.0.1:9090
    # sshd is the other listener Fedora CoreOS enables by default, and ucore's
    # server firewalld profile lets it through on the wired LAN. That is a second
    # door beside the tailnet. Mask it; Tailscale SSH authenticates by tailnet
    # identity and runs inside tailscaled, so a shell over the tailnet still works
    # once the ACL grants it. The Ignition SSH key stays for a manual unmask from
    # the physical console.
    - name: sshd.service
      mask: true
    - name: sshd.socket
      mask: true
    # This box is always on. Masking the sleep targets is what stops an idle
    # policy or a stray `systemctl suspend` from taking it off the network.
    - name: sleep.target
      mask: true
    - name: suspend.target
      mask: true
    - name: hibernate.target
      mask: true
    - name: hybrid-sleep.target
      mask: true
    - name: suspend-then-hibernate.target
      mask: true
    # podman auto-update depends on both the restart unit and this timer. ucore
    # ships them; enable rather than redefine.
    - name: podman-restart.service
      enabled: true
      dropins:
        - name: 10-devbox.conf
          contents: |
            [Unit]
            After=oc-env.service
    - name: podman-auto-update.timer
      enabled: true
