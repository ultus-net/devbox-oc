      {
        "path": "/etc/containers/systemd/opencode.container",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 420
      },
      {
        "path": "/etc/systemd/logind.conf.d/10-devbox.conf",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,H4sIAAAAAAAC/4r2yU/PzIvl8kjMS8lJ9clMCS7PLEnOsM1Mz8svSkUXdq0oSS3KS8wJyC9PLcKhxiU/OTs1BSbpmZKT6phckpmfBxMBBAAA//8S5piocgAAAA=="
        },
        "mode": 420
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=Rebase Fedora CoreOS to ucore-minimal and reboot\nConditionPathExists=!/etc/ucore-autorebase/done\nAfter=network-online.target\nWants=network-online.target\n[Service]\nType=oneshot\nStandardOutput=journal+console\nExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/ublue-os/ucore-minimal:stable\nExecStart=/usr/bin/touch /etc/ucore-autorebase/done\nExecStart=/usr/bin/systemctl disable ucore-autorebase.service\nExecStart=/usr/bin/systemctl reboot\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "ucore-autorebase.service"
      },
      {
        "contents": "[Unit]\nDescription=Devbox data disk\n[Mount]\nWhat=/dev/disk/by-label/data\nWhere=/srv\nType=ext4\nOptions=defaults,noatime,nofail,x-systemd.device-timeout=30s\n[Install]\nWantedBy=local-fs.target\n",
        "enabled": true,
        "name": "srv.mount"
      },
      {
        "contents": "[Unit]\nDescription=Create the persistent directory layout on the data disk\nAfter=srv.mount\nRequires=srv.mount\nBefore=opencode.service\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/local/sbin/oc-paths\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "oc-paths.service"
      },
      {
        "contents": "[Unit]\nDescription=Write the OpenCode environment file from secrets.env\nAfter=srv.mount\nRequires=srv.mount\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/local/sbin/oc-env\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "oc-env.service"
      },
      {
        "contents": "[Unit]\nDescription=Back up the data disk with restic\nAfter=srv.mount network-online.target\nWants=network-online.target\nRequires=srv.mount\n[Service]\nType=oneshot\nNice=10\nIOSchedulingClass=idle\nExecStart=/usr/local/sbin/oc-backup\n",
        "name": "oc-backup.service"
      },
      {
        "contents": "[Unit]\nDescription=Nightly restic backup of the data disk\n[Timer]\nOnCalendar=*-*-* 02:00:00\nPersistent=true\nRandomizedDelaySec=30min\n[Install]\nWantedBy=timers.target\n",
        "enabled": true,
        "name": "oc-backup.timer"
      },
      {
        "enabled": true,
        "name": "tailscaled.service"
      },
      {
        "contents": "[Unit]\nDescription=Join the tailnet and serve OpenCode over TLS\n# The first boot is Fedora CoreOS, which has no tailscale binary. Skip\n# there instead of failing loudly, then run on the ucore boot.\nConditionPathExists=/usr/bin/tailscale\nAfter=network-online.target tailscaled.service\nWants=network-online.target tailscaled.service\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/local/sbin/oc-tailnet-up\nExecStart=/usr/local/sbin/oc-tailnet\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "oc-tailnet.service"
      },
      {
        "dropins": [
          {
            "contents": "[Socket]\nListenStream=\nListenStream=127.0.0.1:9090\n",
            "name": "10-loopback.conf"
          }
        ],
        "name": "cockpit.socket"
      },
      {
        "mask": true,
        "name": "sleep.target"
      },
      {
        "mask": true,
        "name": "suspend.target"
      },
      {
        "mask": true,
        "name": "hibernate.target"
      },
      {
        "mask": true,
        "name": "hybrid-sleep.target"
      },
      {
        "mask": true,
        "name": "suspend-then-hibernate.target"
      },
      {
        "dropins": [
          {
            "contents": "[Unit]\nAfter=oc-env.service\n",
            "name": "10-devbox.conf"
          }
        ],
        "enabled": true,
        "name": "podman-restart.service"
      },
      {
        "enabled": true,
        "name": "podman-auto-update.timer"
      }
    ]
  }
}
