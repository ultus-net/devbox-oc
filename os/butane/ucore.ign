        "mode": 420
      },
      {
        "path": "/etc/devbox/tailscale-authkey",
        "contents": {
          "compression": "",
          "source": "data:,tskey-auth-REPLACE_ME"
        },
        "mode": 384
      },
      {
        "path": "/usr/local/sbin/oc-env",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 493
      },
      {
        "path": "/usr/local/sbin/oc-backup",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 493
      },
      {
        "path": "/usr/local/sbin/oc-tailnet",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 493
      },
      {
        "path": "/usr/local/sbin/oc-tailnet-up",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 493
      },
      {
        "path": "/usr/local/sbin/oc-paths",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,H4sIAAAAAAAC/1yKsQ5DIQgAd76CpjPB/k8X+6RqYsAI7fe/wc3pLpd7PvjTlb2BSyDJD7p65DGQCpLhK6WEVDffgMi+/rxkmm+1KXpZEfaWlxztMv32eo6RQ+AOAAD//x7R0OZ5AAAA"
