  },
  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=Devbox data disk\n[Mount]\nWhat=/dev/disk/by-label/data\nWhere=/srv\nType=ext4\nOptions=defaults,noatime,nofail\n[Install]\nWantedBy=local-fs.target\n",
        "enabled": true,
        "name": "srv.mount"
      },
      {
        "contents": "[Unit]\nDescription=Write OpenCode env and ACR auth from Key Vault\nAfter=network-online.target srv.mount\nWants=network-online.target\n[Service]\nType=oneshot\nRemainAfterExit=yes\nEnvironmentFile=/etc/devbox/oc-secrets.env\nExecStart=/usr/local/sbin/oc-secrets\nExecStart=/usr/local/sbin/oc-acr-login\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "oc-secrets.service"
      },
      {
        "contents": "[Unit]\nDescription=Create persistent directory layout on the data disk\nAfter=srv.mount\nRequires=srv.mount\nBefore=opencode.service\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/local/sbin/oc-paths\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "oc-paths.service"
      },
      {
        "contents": "[Unit]\nDescription=Probe for idleness\nAfter=opencode.service\n[Service]\nType=oneshot\nEnvironmentFile=/etc/devbox/oc-idle.env\nExecStart=/usr/local/sbin/oc-idle-check\n",
        "name": "oc-idle.service"
      },
      {
        "contents": "[Unit]\nDescription=Check idleness every 5 minutes\n[Timer]\nOnBootSec=20min\nOnUnitActiveSec=5min\n[Install]\nWantedBy=timers.target\n",
        "enabled": true,
        "name": "oc-idle.timer"
      },
      {
        "contents": "[Unit]\nDescription=Snapshot the data disk\nAfter=srv.mount\n[Service]\nType=oneshot\nEnvironmentFile=/etc/devbox/oc-snapshot.env\nExecStart=/usr/local/sbin/oc-snapshot\n",
        "name": "oc-snapshot.service"
      },
      {
        "contents": "[Unit]\nDescription=Nightly data disk snapshot\n[Timer]\nOnCalendar=*-*-* 02:00:00 UTC\nPersistent=true\n[Install]\nWantedBy=timers.target\n",
        "enabled": true,
        "name": "oc-snapshot.timer"
      },
      {
        "enabled": true,
        "name": "tailscaled.service"
      },
      {
        "contents": "[Unit]\nDescription=Join the tailnet and serve OpenCode over TLS\nAfter=network-online.target oc-secrets.service tailscaled.service\nWants=network-online.target tailscaled.service\n[Service]\nType=oneshot\nRemainAfterExit=yes\n# A unit does not inherit another unit's EnvironmentFile. Without this the\n# join runs with TS_AUTHKEY_SECRET and VAULT_NAME unset, skips Key Vault\n# entirely, and fails with \"no auth key\" on every fresh boot.\nEnvironmentFile=/etc/devbox/oc-secrets.env\n# Joins only when no state exists, then advertises the loopback port.\nExecStart=/usr/local/sbin/oc-tailnet-up\nExecStart=/usr/local/sbin/oc-tailnet\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "oc-tailnet.service"
      },
      {
        "dropins": [
          {
            "contents": "[Unit]\nAfter=oc-secrets.service\n",
            "name": "10-devbox.conf"
          }
        ],
        "enabled": true,
        "name": "podman-restart.service"
      },
      {
        "enabled": true,
        "name": "podman-auto-update.timer"
      }
    ]
  }
}
