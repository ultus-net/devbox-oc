#!/usr/bin/env bash
# Tag a point-in-time snapshot of the data disk that holds the session DB and
# the repos. Cheap insurance for the case where a rebuild goes wrong.
#
# Creates only. Retention is a documented manual step (docs/runbook.md) because
# deleting backups from a timer deserves a human decision.

set -euo pipefail

DISK_ID="${DISK_ID:?DISK_ID is required}"
RG="${RG:?RG is required}"
SUBSCRIPTION_ID="${SUBSCRIPTION_ID:?SUBSCRIPTION_ID is required}"
LOCATION="${LOCATION:-newzealandnorth}"
IMDS="http://169.254.169.254/metadata/identity/oauth2/token"

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
name="devbox-data-${stamp}"

token="$(curl -fsS -m 10 -H Metadata:true \
  "${IMDS}?api-version=2018-02-01&resource=https%3A%2F%2Fmanagement.azure.com%2F" \
  | jq -r '.access_token')"

base="https://management.azure.com/subscriptions/${SUBSCRIPTION_ID}/resourceGroups/${RG}/providers/Microsoft.Compute/snapshots"

curl -fsS -m 300 -X PUT \
  -H "Authorization: Bearer ${token}" \
  -H "Content-Type: application/json" \
  "${base}/${name}?api-version=2024-07-01" \
  --data @- -o /dev/null <<EOF
{
  "location": "${LOCATION}",
  "properties": {
    "creationData": { "createOption": "Copy", "sourceResourceId": "${DISK_ID}" },
    "incremental": true
  }
}
EOF

logger -t oc-snapshot "created ${name}"
