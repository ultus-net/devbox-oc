#!/usr/bin/env bash
# Fetch the OpenCode server password from Key Vault and write it as the
# documented OPENCODE_PASSWORD variable.
#
# Uses IMDS plus the Key Vault REST API, so no Azure CLI is installed on the
# host. Writes atomically with root-only permissions, and only on success, so
# a transient failure leaves the previous good file in place.

set -euo pipefail

OUT_FILE="${OUT_FILE:-/etc/opencode/env}"
VAULT_NAME="${VAULT_NAME:?VAULT_NAME is required}"
SECRET_NAME="${SECRET_NAME:-opencode-password}"
IMDS="http://169.254.169.254/metadata/identity/oauth2/token"

umask 077
install -d -m 0700 "$(dirname "$OUT_FILE")"

install -d -m 0700 /run/oc-secrets
raw="$(mktemp /run/oc-secrets/secret.XXXXXX)"
tmp="$(mktemp "/etc/opencode/.env.XXXXXX")"
trap 'rm -f "$raw" "$tmp"' EXIT

token="$(curl -fsS -m 10 -H Metadata:true \
  "${IMDS}?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net" \
  | jq -r '.access_token')"

curl -fsS -m 20 \
  -H "Authorization: Bearer ${token}" \
  "https://${VAULT_NAME}.vault.azure.net/secrets/${SECRET_NAME}?api-version=7.4" \
  | jq -r '.value' > "$raw"

value="$(cat "$raw")"
if [ -z "$value" ] || [ "$value" = "null" ]; then
  echo "oc-secrets: empty or missing secret, refusing to write" >&2
  exit 1
fi

printf 'OPENCODE_PASSWORD=%s\n' "$value" > "$tmp"
mv "$tmp" "$OUT_FILE"
trap 'rm -f "$raw"' EXIT
chmod 0600 "$OUT_FILE"
