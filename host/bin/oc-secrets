#!/usr/bin/env bash
# Fetch the OpenCode server password from Key Vault and write it as the
# documented OPENCODE_PASSWORD variable.
#
# Uses IMDS plus the Key Vault REST API, so no Azure CLI is installed on the
# host. Writes atomically with root-only permissions, and only on success, so
# a transient failure leaves the previous good file in place.

set -euo pipefail

# No default. The path the container loads is defined once, in the unit env file
# that Ignition writes (/etc/devbox/oc-secrets.env), and a guard test requires that
# definition to be the only one and to match the quadlet's EnvironmentFile.
#
# A fallback here would be a second definition of the same fact, which is how the
# two drifted apart in the first place. Requiring it also fails closed: if the
# boot path ever stops supplying it, oc-secrets fails, the container's
# Requires=oc-secrets.service fails with it, and nothing serves. That is visible
# immediately, unlike a silent write to a file nobody reads.
#
# `:` rather than an assignment, so this script never sets OUT_FILE at all. The guard
# runs it with OUT_FILE readonly, which makes any assignment fail at runtime whatever
# its shape: line-initial, conditional, inside a function, or an append.
: "${OUT_FILE:?OUT_FILE is required, set by /etc/devbox/oc-secrets.env}"
VAULT_NAME="${VAULT_NAME:?VAULT_NAME is required}"
SECRET_NAME="${SECRET_NAME:-opencode-password}"

# shellcheck disable=SC1090,SC1091
. "$(dirname "$0")/lib-imds.sh"

umask 077
OUT_DIR="$(dirname "$OUT_FILE")"
install -d -m 0700 "$OUT_DIR"

value="$(kv_secret "$VAULT_NAME" "$SECRET_NAME")"
if [ -z "$value" ] || [ "$value" = "null" ]; then
  echo "oc-secrets: empty or missing secret, refusing to write" >&2
  exit 1
fi

tmp="$(mktemp "${OUT_DIR}/.env.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
printf 'OPENCODE_PASSWORD=%s\n' "$value" > "$tmp"
mv "$tmp" "$OUT_FILE"
chmod 0600 "$OUT_FILE"
