#!/usr/bin/env bash
# Join or refresh the tailnet, using the scoped auth key from Ignition.
#
# The key is the only secret that ever touches the install media. It is written
# to /etc/devbox/tailscale-authkey at mode 0600. After a successful join this
# script deletes it, so a revoked key cannot fail every later boot. Revoking the
# key in the admin console is still worth doing, but the node does not depend on
# it: identity lives in /var/lib/tailscale.
#
# `tailscale up` is idempotent. Running it on every boot with a key present
# refreshes prefs and keeps the existing node identity; it does not mint a new
# node. Skipping it whenever a state file exists is what leaves a half-started
# node off the tailnet, so the key decides, not the file.
#
# A failed `up` with state present is not fatal. The node keeps its identity and
# the service must still reach the serve step below, or a revoked key would latch
# the box off the tailnet.
#
# --ephemeral is deliberately NOT used: the node identity must be stable so
# MagicDNS and the client's saved server URL keep working across restarts.
set -euo pipefail

STATE_DIR="${STATE_DIR:-/var/lib/tailscale}"
AUTH_KEY_FILE="${AUTH_KEY_FILE:-/etc/devbox/tailscale-authkey}"
LOGIN_SERVER="${LOGIN_SERVER:-}"

if [ -r "$AUTH_KEY_FILE" ] && [ -s "$AUTH_KEY_FILE" ]; then
  args=(--auth-key "file:$AUTH_KEY_FILE" --hostname "$(hostname)" --accept-routes=false)
  [ -n "$LOGIN_SERVER" ] && args+=(--login-server "$LOGIN_SERVER")
  rc=0
  tailscale up "${args[@]}" || rc=$?
  if [ "$rc" -eq 0 ]; then
    rm -f "$AUTH_KEY_FILE"
    exit 0
  fi
  if [ -f "$STATE_DIR/tailscaled.state" ]; then
    echo "oc-tailnet-up: tailscale up failed; keeping the existing node state" >&2
    exit 0
  fi
  echo "oc-tailnet-up: tailscale up failed and no node state exists" >&2
  exit "$rc"
fi

# No key is the normal post-join state, because the join deletes it. Keep the
# node then, but never report success on a box with neither a key nor state.
if [ -f "$STATE_DIR/tailscaled.state" ]; then
  echo "oc-tailnet-up: no auth key, but tailnet state is present"
  exit 0
fi

echo "oc-tailnet-up: no auth key at $AUTH_KEY_FILE and no tailnet state" >&2
exit 1
