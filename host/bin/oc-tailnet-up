#!/usr/bin/env bash
# Join the tailnet on first boot, using the scoped auth key from Ignition.
#
# The key is the only secret that ever touches the install media. It is written
# to /etc/devbox/tailscale-authkey at mode 0600 and revoked in the admin console
# after the node appears. Revoking does not remove the node: identity lives in
# /var/lib/tailscale.
#
# --ephemeral is deliberately NOT used: the node identity must be stable so
# MagicDNS and the client's saved server URL keep working across restarts.
set -euo pipefail

STATE_DIR="${STATE_DIR:-/var/lib/tailscale}"
AUTH_KEY_FILE="${AUTH_KEY_FILE:-/etc/devbox/tailscale-authkey}"
LOGIN_SERVER="${LOGIN_SERVER:-}"

# State present means the node already joined. Re-authenticating on every boot
# would mint a new node whenever the old key was revoked, which is exactly what
# revoking it after install is meant to avoid.
if [ -f "$STATE_DIR/tailscaled.state" ]; then
  echo "oc-tailnet-up: state present, leaving tailscale as configured"
  exit 0
fi

[ -r "$AUTH_KEY_FILE" ] || { echo "oc-tailnet-up: no auth key at $AUTH_KEY_FILE" >&2; exit 1; }
[ -s "$AUTH_KEY_FILE" ] || { echo "oc-tailnet-up: auth key file is empty" >&2; exit 1; }

args=(--auth-key "file:$AUTH_KEY_FILE" --hostname "$(hostname)" --accept-routes=false)
[ -n "$LOGIN_SERVER" ] && args+=(--login-server "$LOGIN_SERVER")

tailscale up "${args[@]}"
