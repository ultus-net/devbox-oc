[Unit]
Description=Start the devbox containers
Requires=oc-secrets.service
After=oc-secrets.service tailscaled.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/devbox
EnvironmentFile=/etc/devbox/compose.env
ExecStart=/usr/bin/docker compose up --detach --wait --wait-timeout 180
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
