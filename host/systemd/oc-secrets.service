[Unit]
Description=Write the OpenCode server env file from Key Vault
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/devbox/oc-secrets.env
# oc-secrets writes atomically and only on success, so a failed fetch leaves
# the previous good file in place rather than a truncated one.
ExecStart=/usr/local/sbin/oc-secrets
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
